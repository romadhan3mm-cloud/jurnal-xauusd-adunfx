{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traderlogs-ai-news-alerts",
  "main": "worker/ai-news-worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "ALERTS_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE_WITH_YOUR_TRADERLOGS_DOMAIN"
  }
}
