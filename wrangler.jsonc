{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traderlogs",
  "main": "worker/ai-news-worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "ALERTS_KV", "id": "7979255a5af9404aabb7385185a8b195" }
  ]
}
